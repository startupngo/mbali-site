# Copy to .env and fill in. Real hosts (Render, Railway, Fly) set these in their dashboard instead.
BRAND_NAME=Mbali
ADMIN_USER=zak
ADMIN_PASSWORD=change-me-before-launch
DATABASE_PATH=./data/sokoni.sqlite
SITE_URL=http://localhost:3000
SEED_PROSPECTS=1
# Optional email notifications (any SMTP provider). Leave blank to skip — everything is in /admin anyway.
NOTIFY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
